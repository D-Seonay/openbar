NEST_API_URL=http://localhost:3001
JWT_SECRET=dev-secret-change-me
# COOKIE_SECURE=true # only enable if a reverse proxy terminates TLS in front of the app

# Discord integration (optional — the link button is hidden when unset).
# Create an application at https://discord.com/developers/applications
DISCORD_CLIENT_ID=
# Secret: set it on the server only, never commit it.
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-host/api/discord/callback
# Bot token, API only — needed to publish the 'à ramener' board.
DISCORD_BOT_TOKEN=
# Optional: whole-broadcast budget for DM announcements, in ms (default 20000).
# DISCORD_BROADCAST_BUDGET_MS=20000
